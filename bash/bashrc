# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
PATH="$HOME/.opencode/bin:$PATH"
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# bash history
shopt -s histappend
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoreboth
export HISTIGNORE="ls:pwd:exit:clear:git status:git branch:edit-fzf"
export PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# export PS1="\[\e[0;36m\]\\w \\$ \[\e[0m\]"
export EDITOR="nano"

function gitClean {
  git checkout master; git branch | grep -v master | grep -v release | grep -v develop | grep -v main | xargs git branch -D
}
alias git-clean=gitClean

function gitCommit {
  task=$(git branch --show-current | grep -Eo "DEV-[0-9]+") && git commit -m "$task $1"
}
alias git-commit=gitCommit

function gitAddAndCommit {
  task=$(git branch --show-current | grep -Eo "DEV-[0-9]+") && git add . && git commit -m "$task $1"
}
alias git-add-and-commit=gitAddAndCommit

function proxyActivate {
  export HTTP_PROXY=http://127.0.0.1:10809
  export HTTPS_PROXY=http://127.0.0.1:10809
  export NO_PROXY=localhost,127.0.0.1
}
alias proxy-activate=proxyActivate

alias edit="flatpak run org.gnome.TextEditor"
alias edit-fzf='edit $(fzf)'
alias nano-fzf='nano $(fzf)'
alias chrome-testing='toolbox run -c dev-utils chrome'
alias docx2pdf='toolbox run -c sys-utils -- env SAL_USE_VCLPLUGIN=svp soffice --headless --convert-to pdf --outdir "$(dirname -- "$1")" "$1"'

function devcontainersStart {
    podman start $(podman ps -a --filter "label=$1" --filter "status=exited" -q) 2>/dev/null
}
alias dc-start=devcontainersStart

function devcontainersStop {
    podman stop $(podman ps -a --filter "label=$1" --filter "status=running" -q) 2>/dev/null
}
alias dc-stop=devcontainersStop

function devcontainersStopAll {
    podman stop $(podman ps -a --filter "label=devcontainer.local_folder" --filter "status=running" -q) 2>/dev/null
}
alias dc-stop-all=devcontainersStopAll

function devcontainersCleanAll {
    podman rm -f $(podman ps -a --filter "label=devcontainer.local_folder" --filter "status=exited" -q) 2>/dev/null
}
alias dc-clean-all=devcontainersCleanAll

function devcontainersClean {
    podman rm -f $(podman ps -a --filter "label=$1" --filter "status=exited" -q) 2>/dev/null
}
alias dc-clean=devcontainersClean

function testcontainersClean {
    podman rm -f $(podman ps -a --filter "label=org.testcontainers" -q) 2>/dev/null
}
alias tc-clean=testcontainersClean

command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
