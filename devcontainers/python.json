{
  "name": "Python $module dev container",
  "image": "mcr.microsoft.com/devcontainers/python:dev-3.14",
  "postCreateCommand": "pipx install poetry && cd ${containerWorkspaceFolder} && poetry install",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:SSH_AUTH_SOCK},target=/tmp/ssh-agent.socket,type=bind"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/tmp/ssh-agent.socket"
  },
  "runArgs": [
    "--label", "dc.project=$project",
    "--label", "dc.lang=$lang"
  ]
}
