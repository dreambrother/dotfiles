{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OC_MODEL}",
  "websearch": {
    "provider": "tinyfish",
  },
  "providers": {
    "routerai": {
      "name": "RouterAI",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "compatibility": {
        "supportsPromptCacheKey": true,
      },
      "settings": {
        "baseURL": "https://routerai.ru/api/v1",
      },
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 100000,
          },
        },
        "xiaomi/mimo-v2.6-pro": {
          "name": "MiMo V2.6 Pro",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 100000,
          },
        },
        "xiaomi/mimo-v2.6-flash": {
          "name": "MiMo V2.6 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 100000,
          },
        },
        "z-ai/glm-5.3": {
          "name": "GLM-5.3",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 100000,
          },
        },
      },
    },
    "litellm": {
      "name": "LiteLLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{file:~/.config/secrets/litellm-baseurl}",
      },
      "headers": {
        "x-litellm-session-id": "{file:~/.config/secrets/litellm-session-id}",
      },
      "models": {
        "or-deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "or-glm-5.3": {
          "name": "GLM-5.3",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "or-glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "or-mimo-v2.5": {
          "name": "MiMo V2.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "grok-4.7": {
          "name": "Grok 4.7",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "toolbox",
          "run",
          "-c",
          "dev-utils",
          "/bin/sh",
          "-c",
          "npx -y chrome-devtools-mcp@1.11.0 --no-usage-statistics",
        ],
      },
    },
  },
  "agents": {
    "title": {
      "model": "{env:OC_TITLE_MODEL}",
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "{env:OC_REVIEW_MODEL}",
      "system": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }],
    },
    "coder": {
      "description": "Handles coding tasks: implementation, fixes, and code changes",
      "mode": "subagent",
      "model": "{env:OC_CODER_MODEL}",
      "system": "You are a focused coding agent. Given a task, implement it directly: locate relevant code, make edits, and verify. Follow the codebase conventions and existing patterns.",
    },
    "explore": {
      "mode": "subagent",
      "model": "{env:OC_EXPLORE_MODEL}",
    },
    "vision": {
      "description": "Views and analyzes images (screenshots, photos, diagrams). Use ONLY when the current model has no vision support and you need to see a picture, describe its content, extract text, or answer questions about a visual.",
      "mode": "subagent",
      "model": "{env:OC_VISION_MODEL}",
      "system": "{file:~/dotfiles/opencode/vision-prompt.txt}",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }],
    },
  },
}
