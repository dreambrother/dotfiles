{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "setCacheKey": true,
      },
      "models": {
        "deepseek/deepseek-v4-pro-0813": { "name": "DeepSeek V4 Pro 0831" },
        "deepseek/deepseek-v4-flash-0731": { "name": "DeepSeek V4 Flash 0731" },
        "xiaomi/mimo-v2.5-pro": { "name": "MiMo V2.5 Pro" },
        "xiaomi/mimo-v2.5": {
          "name": "MiMo V2.5",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "z-ai/glm-5.3": { "name": "GLM-5.3" },
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "toolbox", "run", "-c", "dev-utils",
        "/bin/sh", "-c", "npx -y chrome-devtools-mcp@latest --no-usage-statistics"
      ],
      "enabled": true,
    },
  },
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
    "coder": {
      "description": "Handles coding tasks: implementation, fixes, and code changes",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "You are a focused coding agent. Given a task, implement it directly: locate relevant code, make edits, and verify. Follow the codebase conventions and existing patterns.",
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
    },
  },
}
