{
  "$schema": "https://opencode.ai/config.json",
  "model": "routerai/deepseek/deepseek-v4.1-flash",
  "small_model": "routerai/xiaomi/mimo-v2.6-flash",
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "setCacheKey": true,
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "xiaomi/mimo-v2.6-pro": {
          "name": "MiMo V2.6 Pro",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "xiaomi/mimo-v2.6-flash": {
          "name": "MiMo V2.6 Flash",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "z-ai/glm-5.3": {
          "name": "GLM-5.3",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "toolbox",
        "run",
        "-c",
        "dev-utils",
        "/bin/sh",
        "-c",
        "npx -y chrome-devtools-mcp@latest --no-usage-statistics",
      ],
      "enabled": true,
    },
  },
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "routerai/z-ai/glm-5.3",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
    "coder": {
      "description": "Handles coding tasks: implementation, fixes, and code changes",
      "mode": "subagent",
      "model": "routerai/deepseek/deepseek-v4.1-flash",
      "prompt": "You are a focused coding agent. Given a task, implement it directly: locate relevant code, make edits, and verify. Follow the codebase conventions and existing patterns.",
    },
    "explore": {
      "model": "routerai/deepseek/deepseek-v4.1-flash",
    },
    "vision": {
      "description": "Views and analyzes images (screenshots, photos, diagrams). Use ONLY when the current model has no vision support and you need to see a picture, describe its content, extract text, or answer questions about a visual.",
      "mode": "subagent",
      "model": "routerai/xiaomi/mimo-v2.6-flash",
      "prompt": "{file:~/dotfiles/opencode/vision-prompt.txt}",
      "permission": {
        "edit": "deny",
      },
    },
  },
}
