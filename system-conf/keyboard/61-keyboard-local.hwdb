# Переназначение клавиш на внешней клавиатуре (hwdb)
#
# Действует только на совпадающие по modalias/имени устройства.
# Не влияет на встроенную клавиатуру ноутбука.
#
# Установка: см. README.md в этой же папке.

# === Провод / 2.4 ГГц донгл (USB, vendor:product = 5566:000a) ===
# Имя ядра: "YJS MicroChip MKEY NOVA Driver"
evdev:input:b0003v5566p000A*
 KEYBOARD_KEY_700e4=home

# === Bluetooth ===
# BT-HID не передаёт meaningful vendor/product (0000:0000).
# modalias-матч (первый lookup в 60-evdev.rules, работает для всех
# event-устройств) — самый надёжный вариант для BT.
evdev:input:b0005v0000p0000*
 KEYBOARD_KEY_700e4=home

# Запасной: name+DMI-матч (запускается только при KERNELS=="input*",
# что для BT может не сработать — оставлено на всякий случай).
evdev:name:MKEY NOVA 1 Keyboard:dmi:bvn*:bvr*:bd*:svnLENOVO:*
 KEYBOARD_KEY_700e4=home
