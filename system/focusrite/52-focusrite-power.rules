# focusrite-fix: дать пользователю nvs право рвать питание (VBUS) портов
# USB-хабов Realtek (0bda) без root. Используется скриптом scripts/focusrite-fix
# для оживления Focusrite Scarlett Solo 2nd Gen после сна: сброс порта через
# sysfs-файл <хаб>-port<N>/disable (в ядре >= 6.0 это usb_hub_set_port_power).
#
# Установка (один раз):
#   sudo install -m644 52-focusrite-power.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=usb
#   focusrite-fix -n     # проверить, что sysfs-путь доступен на запись
#
# Полный откат:
#   sudo rm /etc/udev/rules.d/52-focusrite-power.rules
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=usb

SUBSYSTEM=="usb", DRIVER=="hub", ATTRS{idVendor}=="0bda", RUN+="/bin/sh -c 'for f in $sys$devpath/*port*/disable; do chown -f nvs \"$f\" 2>/dev/null; chmod -f 660 \"$f\" 2>/dev/null; done; true'"
