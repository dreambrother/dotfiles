// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "always_treat_brackets_as_autoclosed": true,
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Zed (Default)",
  "use_podman": true,

  "proxy": "socks5h://127.0.0.1:10808",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "diff_view_style": "unified",
  "show_edit_predictions": true,
  "ssh_connections": [],
  "restore_on_startup": "launchpad",
  "format_on_save": "off",
  "project_panel": {
    "starts_open": true,
    "auto_reveal_entries": true,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^poetry\\s+run(\\s|$)",
            },
            {
              "pattern": "^mvn\\s+compile(\\s|$)",
            },
            {
              "pattern": "^tail\\b",
            },
            {
              "pattern": "^mvn\\s+test(\\s|$)",
            },
            {
              "pattern": "^ls\\b",
            },
            {
              "pattern": "^cat\\s+target/surefire-reports/\\*\\.txt(\\s|$)",
            },
            {
              "pattern": "^head\\b",
            },
            {
              "pattern": "^mvn\\s+verify(\\s|$)",
            },
            {
              "pattern": "^grep\\b",
            },
            {
              "pattern": "^mvn\\s+dependency:tree(\\s|$)",
            },
            {
              "pattern": "^git\\b",
            },
            {
              "pattern": "^cat\\b",
            },
            {
              "pattern": "^sed\\b",
            },
            {
              "pattern": "^cd\\s+/Users/nshmakov/Sources/ticket/gateway-service(\\s|$)",
            },
            {
              "pattern": "^mvn\\s+test-compile(\\s|$)",
            },
            {
              "pattern": "^mvn\\s+clean(\\s|$)",
            },
            {
              "pattern": "^GIT_EDITOR=true\\s+git\\s+commit(\\s|$)",
            },
            {
              "pattern": "^cd\\s+/tmp(\\s|$)",
            },
            {
              "pattern": "^jar\\s+tf(\\s|$)",
            },
            {
              "pattern": "^jar\\s+xf(\\s|$)",
            },
            {
              "pattern": "^diff\\s+/Users/nshmakov/Sources/ticket/gateway-service/src/test/resources/containers_new/order/create/ms_add_user\\.sql(\\s|$)",
            },
            {
              "pattern": "^wc\\b",
            },
            {
              "pattern": "^cut\\b",
            },
            {
              "pattern": "^sort\\b",
            },
            {
              "pattern": "^find\\s+\\~/\\.m2/repository/org/springframework/spring-test(\\s|$)",
            },
            {
              "pattern": "^unzip\\b",
            },
            {
              "pattern": "^echo\\b",
            },
            {
              "pattern": "^ls\\s+cli/\\.venv/bin/(\\s|$)",
            },
            {
              "pattern": "^go\\s+run(\\s|$)",
            },
            {
              "pattern": "^go\\s+build(\\s|$)",
            },
            {
              "pattern": "^python\\b",
            },
          ],
        },
      },
    },
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": false,
    },
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "language_models": {
    "openai_compatible": {
      "RouterAI": {
        "api_url": "https://routerai.ru/api/v1",
        "available_models": [
          {
            "name": "z-ai/glm-5.3",
            "max_tokens": 1000000,
            "max_output_tokens": 320000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
          {
            "name": "z-ai/glm-5.3-flash",
            "max_tokens": 1000000,
            "max_output_tokens": 320000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
        ],
      },
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "languages": {
    "Python": {
      "preferred_line_length": 120,
    },
    "Java": {
      "format_on_save": "off",
      "inlay_hints": {
        "enabled": true,
      },
      "preferred_line_length": 120,
      "hard_tabs": false,
      "tab_size": 4,
    },
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": false,
          },
        },
      },
    },
  },
}
