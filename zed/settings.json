{
  "icon_theme": "Zed (Default)",
  // "ui_font_size": 16,
  // "buffer_font_size": 15,
  "use_podman": true,

  // "proxy": "socks5h://127.0.0.1:10808",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed"
